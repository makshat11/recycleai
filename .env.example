# =============================================================================
#  RecycleVision AI -- server-side configuration
#  Copy to .env.local and fill in at least one provider key.
#  None of these is prefixed with VITE_, so none is ever bundled into the browser.
# =============================================================================

# ---- Groq: fast text analysis (https://console.groq.com/keys) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Groq's catalogue is text-only for this project. Leave GROQ_VISION_MODEL empty
# so photographs are routed to a provider that accepts image content parts.
GROQ_VISION_MODEL=

# ---- NVIDIA NIM: photo identification + text fallback (https://build.nvidia.com) ----
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_VISION_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Preference order for both stages. Values: groq, nvidia
# A provider with no key, or no model set for the stage in question, is skipped.
AI_PROVIDER_ORDER=groq,nvidia
